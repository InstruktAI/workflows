{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "InstruktAI shared Renovate preset: green non-major updates auto-merge after a 3-day release age; security fixes skip the wait.",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Non-major updates merge once every check on the PR is green.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates wait for a human.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": false
  }
}
